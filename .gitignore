# Logs and temporary files
*.log
*.cache
*.tmp
*.swp

# System files
.DS_Store
Thumbs.db

# IDE and editor settings
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Composer dependencies (if using Composer)
vendor/

# Node.js dependencies (if using Node.js for frontend)
node_modules/

# Environment configuration files
.env
.env.*

# Uploads and storage
/uploads/

# Docker
docker-compose.override.yml
docker-compose.override.yaml
.dockerignore

# PHP Storm specific files
*.iml

# Cache and session files
public/storage/
public/uploads/
storage/*.key
storage/framework/*
storage/logs/*
storage/app/public/*

# Debugging files
*.php~
*.bak

# Generated files
*.class
*.min.js
*.min.css

# Exclude build artifacts
build/
dist/

# Exclude database files
*.sql
*.sqlite
*.db

# Exclude cache generated by PHP
composer.lock

# Operating system files
*.bak
*.old

# Node.js Build Cache
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Exclude sensitive files
credentials.json
